# --- Required ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# --- Models (any OpenRouter model id) ---
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1

# --- Storage ---
DB_PATH=data/marketing_brain.db
WORKSPACES_ROOT=workspaces/

# --- Optional ---
# DIRECT_ACCESS=true                               # opens the admin workspace without a login
# PUBLIC_BASE_URL=https://your-app.onrender.com   # needed for IG image publishing
# ADMIN_EMAIL=you@example.com                      # auto-creates an admin on boot
# ADMIN_PASSWORD=change-me

# --- Airtable Content Operations ---
# Create a dedicated Airtable PAT and a random webhook secret. Never put either in Airtable.
# AIRTABLE_TOKEN=pat_xxxxxxxxxxxxxxxxx
# AIRTABLE_WEBHOOK_SECRET=replace-with-a-long-random-value
AIRTABLE_BASE_ID=appvpMfpbNQDkUGeF
AIRTABLE_CONTENT_TABLE_ID=tblWu3YzDoasrj0OG
AIRTABLE_SLIDES_TABLE_ID=tblAbMcwp6DipTQqu
AIRTABLE_CLAIMS_TABLE_ID=tbluMV1yECqSjpY0S
AIRTABLE_PROJECTS_TABLE_ID=tblXdFUMM6E6qSKLF
AIRTABLE_BRAND_RULES_TABLE_ID=tblP2Gqh59vI79IqW
AIRTABLE_RUNS_TABLE_ID=tblir6QJU0Vo4qBeP
